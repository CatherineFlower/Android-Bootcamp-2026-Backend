<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet id="2026-01-28--0004-employee-meeting" author="indx0">
        <preConditions>
            <not>
                <tableExists tableName="employee_meeting"/>
            </not>
        </preConditions>

        <createTable tableName="employee_meeting">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>

            <column name="employee_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_employee_em" referencedTableName="employee"
                         referencedColumnNames="id"/>
            </column>

            <column name="meeting_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_meeting_em" referencedTableName="meeting"
                             referencedColumnNames="id"/>
            </column>

        </createTable>
    </changeSet>

</databaseChangeLog>