<?xml version="1.0" encoding="UTF-8" ?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">


    <changeSet id="01-29-2026--0003-meeting_participants" author="ssavelev">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="meeting_participants"/>
            </not>
        </preConditions>

        <createTable tableName="meeting_participants">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="meeting_id" type="INT">
                <constraints nullable="false"
                             foreignKeyName="fk_participant_meeting"
                             referencedTableName="meetings"
                             referencedColumnNames="id"/>
            </column>
            <column name="creator" type="BIGINT">
                <constraints nullable="false"
                             foreignKeyName="fk_participant_creator"
                             referencedTableName="users"
                             referencedColumnNames="id"/>
            </column>
            <column name="invitedUser" type="BIGINT">
                <constraints nullable="false"
                             foreignKeyName="fk_participant_user"
                             referencedTableName="users"
                             referencedColumnNames="id"/>
            </column>
            <column name="accepted_invitation" type="BIT">
                <constraints nullable="true"/>
            </column>

        </createTable>
    </changeSet>
</databaseChangeLog>