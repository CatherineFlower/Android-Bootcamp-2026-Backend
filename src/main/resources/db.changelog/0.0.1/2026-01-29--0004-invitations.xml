<?xml version="1.0" encoding="UTF-8" ?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet id="2026-01-29--0004-invitations" author="klim">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="invitations"/>
            </not>
        </preConditions>

        <createTable tableName="invitations">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false" unique="true"/>
            </column>

            <column name="user_id" type="BIGINT">
                <constraints
                        foreignKeyName="fk_invitations_users"
                        referencedTableName="users"
                        referencedColumnNames="id"
                        deleteCascade="true"
                        nullable="false"
                />
            </column>
            <column name="meeting_id" type="BIGINT">
                <constraints
                        foreignKeyName="fk_invitations_meetings"
                        referencedTableName="meetings"
                        referencedColumnNames="id"
                        deleteCascade="true"
                        nullable="false"
                />
            </column>

            <column name="status" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="responded_at" type="DATETIME"/>
            <column name="created_at" type="DATETIME" defaultValueComputed="current_datetime">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

</databaseChangeLog>
