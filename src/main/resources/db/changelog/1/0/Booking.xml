<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.0.xsd
        http://www.liquibase.org/xml/ns/dbchangelog-ext http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd">
    <changeSet id="2026-01-23--2" author="Dmitry">
        <createTable tableName="Booking">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints nullable="false" unique="true" primaryKey="true"/>
            </column>
            <column name="name" type="VARCHAR(100)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="Employee_Admin" type="BIGINT" >
                <constraints nullable="false" unique="false" references="Employee(id)" foreignKeyName="fk_Booking_Employee"/>
            </column>
            <column name="start_Booking" type="TIMESTAMP">
                <constraints nullable="false" unique="false" />
            </column>
            <column name="end_Booking" type="TIMESTAMP">
                <constraints nullable="false" unique="false" />
            </column>
        </createTable>
    </changeSet>
</databaseChangeLog>